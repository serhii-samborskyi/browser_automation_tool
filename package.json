{
  "name": "playwright-automation-runner",
  "version": "0.2.0",
  "description": "Local Playwright automation script runner with persistent browser profile and stealth setup.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "restart": "bash ./restart.sh",
    "install-and-run": "bash ./install_and_run.sh --local --port 4300",
    "install-full": "bash ./install_and_run.sh --full --port 4300",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "mcp": "node ./mcp_server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@prisma/client": "^6.19.3",
    "body-parser": "^1.20.2",
    "camoufox-js": "^0.10.2",
    "express": "^4.19.2",
    "fingerprint-generator": "^2.1.77",
    "fingerprint-injector": "^2.1.77",
    "playwright": "^1.48.2",
    "playwright-extra": "^4.3.6",
    "prisma": "^6.19.3",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "playwright-with-fingerprints": "^1.3.22"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
